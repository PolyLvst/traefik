# Traefik Configuration
# Copy this file to .env and update with your values

# Email for Let's Encrypt notifications
ACME_EMAIL=your-email@example.com

# Domain for Traefik dashboard
TRAEFIK_DOMAIN=traefik.yourdomain.com

# Basic Auth for dashboard (generate with: echo $(htpasswd -nbB admin your-password))
# Default is admin:admin - CHANGE THIS!
TRAEFIK_AUTH=admin:$$2y$$05$$hKFQWKVQNKJKXiGDZ8l8qOMGmZ0K0zLqCKWXVWXVVWXVWXVWXVWXV
